<?xml version="1.0" encoding="UTF-8"?>

<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"

         xsi:schemaLocation="
         http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"

         version="4.0">

<!-- ================= HOME ================= -->

<welcome-file-list>
    <welcome-file>index.jsp</welcome-file>
</welcome-file-list>

<!-- ================= REGISTER ================= -->

<servlet>
    <servlet-name>RegisterServlet</servlet-name>

    <servlet-class>
        controller.RegisterServlet
    </servlet-class>
</servlet>

<servlet-mapping>
    <servlet-name>RegisterServlet</servlet-name>

    <url-pattern>/register</url-pattern>
</servlet-mapping>

<!-- ================= USER LOGIN ================= -->

<servlet>
    <servlet-name>LoginServlet</servlet-name>

    <servlet-class>
        controller.LoginServlet
    </servlet-class>
</servlet>

<servlet-mapping>
    <servlet-name>LoginServlet</servlet-name>

    <url-pattern>/login</url-pattern>
</servlet-mapping>

<!-- ================= ADMIN LOGIN ================= -->

<servlet>
    <servlet-name>AdminLoginServlet</servlet-name>

    <servlet-class>
        controller.AdminLoginServlet
    </servlet-class>
</servlet>

<servlet-mapping>
    <servlet-name>AdminLoginServlet</servlet-name>

    <url-pattern>/adminLogin</url-pattern>
</servlet-mapping>

<!-- ================= APPLY PASS ================= -->

<servlet>
    <servlet-name>ApplyPassServlet</servlet-name>

    <servlet-class>
        controller.ApplyPassServlet
    </servlet-class>
</servlet>

<servlet-mapping>
    <servlet-name>ApplyPassServlet</servlet-name>

    <url-pattern>/applyPass</url-pattern>
</servlet-mapping>

<!-- ================= PAYMENT ================= -->

<servlet>
    <servlet-name>PaymentServlet</servlet-name>

    <servlet-class>
        controller.PaymentServlet
    </servlet-class>
</servlet>

<servlet-mapping>
    <servlet-name>PaymentServlet</servlet-name>

    <url-pattern>/payment</url-pattern>
</servlet-mapping>

<!-- ================= UPDATE PASS STATUS ================= -->

<servlet>
    <servlet-name>UpdatePassStatusServlet</servlet-name>

    <servlet-class>
        controller.UpdatePassStatusServlet
    </servlet-class>
</servlet>

<servlet-mapping>
    <servlet-name>UpdatePassStatusServlet</servlet-name>

    <url-pattern>/updatePassStatus</url-pattern>
</servlet-mapping>

<!-- ================= DELETE PASS ================= -->

<servlet>
    <servlet-name>DeletePassServlet</servlet-name>

    <servlet-class>
        controller.DeletePassServlet
    </servlet-class>
</servlet>

<servlet-mapping>
    <servlet-name>DeletePassServlet</servlet-name>

    <url-pattern>/deletePass</url-pattern>
</servlet-mapping>

</web-app>